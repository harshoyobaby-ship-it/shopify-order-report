# Shopify store
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-10

# OAuth client credentials (from Dev Dashboard → your app → Settings)
# App must be installed on the store. Token is fetched automatically (24h lifetime).
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Optional: skip OAuth and use a static Admin API token (shpat_...) instead
# SHOPIFY_ACCESS_TOKEN=

# Report date range
REPORT_START_DATE=2024-01-01
REPORT_END_DATE=2024-12-31

# Optional: limit orders for testing (0 = no limit)
MAX_ORDERS=0

# HTTP / retry
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=5
RETRY_BACKOFF_MULTIPLIER=2
RETRY_MIN_WAIT_SECONDS=1
RETRY_MAX_WAIT_SECONDS=60

# Rate limits
SHOPIFY_REQUESTS_PER_SECOND=2

# Web app (optional) — required on public deployments
# APP_PASSWORD=choose-a-strong-password

# Paths
LOG_LEVEL=INFO
REPORTS_DIR=reports
LOGS_DIR=logs
