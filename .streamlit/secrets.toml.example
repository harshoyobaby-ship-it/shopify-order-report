# Copy to .streamlit/secrets.toml for local Streamlit runs.
# On Streamlit Cloud: paste into App settings → Secrets.

SHOPIFY_SHOP_DOMAIN = "gaddaco.myshopify.com"
SHOPIFY_API_VERSION = "2026-01"
SHOPIFY_CLIENT_ID = "your_client_id"
SHOPIFY_CLIENT_SECRET = "your_client_secret"

# Optional: require password before using the app (recommended if URL is public)
APP_PASSWORD = "choose-a-strong-password"
